# Copy to .env:  cp template.env .env
# Release tags used when building the images.
# If %publish fails, align both on the same release (e.g. 2026-04).

# SysML-v2-API-Services tag (latest available: 2026-04)
API_TAG=2026-04

# SysML-v2-Release (Jupyter kernel) tag (newer ones exist, e.g. 2026-09.1)
RELEASE_TAG=2026-08

# Host ports (change if the defaults are already in use on your machine).
# Only the host side changes; containers still talk to each other on 5432/9000.
POSTGRES_PORT=5432
API_PORT=9000
JUPYTER_PORT=8888

# Address the API and JupyterLab ports are published on.
# 0.0.0.0 = reachable from other machines; 127.0.0.1 = this machine only.
BIND_ADDRESS=0.0.0.0

# JupyterLab login token. EMPTY = no login (anyone who can reach the port can run code).
# Set a value (e.g. a long random string) whenever the server is reachable from a network.
JUPYTER_TOKEN=

# Registry/owner the prebuilt images are pulled from (published by .github/workflows/docker.yml).
# Use `docker compose pull` to download them, or `docker compose up -d --build` to build locally.
IMAGE_PREFIX=ghcr.io/nhaskaris

# Host names/IPs the API accepts in requests (comma separated). "." or "*" = any host.
# Restrict it when the server is exposed, e.g. ALLOWED_HOSTS=localhost,api,10.100.52.117
ALLOWED_HOSTS=.
